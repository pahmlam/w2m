# API is contacted by the browser; only public configuration belongs here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional MapLibre style JSON, used instead of the raster basemap if set.
NEXT_PUBLIC_MAP_STYLE_URL=
# CARTO Positron raster template. Set these values for an authorized CARTO account.
# NEXT_PUBLIC_MAP_TILE_URL="https://a.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png?key=YOUR_PUBLIC_CARTO_KEY"
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION="© CARTO"
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION_URL=https://carto.com/attributions
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION_URL=
